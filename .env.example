# Host port for the drill UI/API
DRILL_PORT=8000
# Host port for the optional virtual-clock (fast-forward) service
DRILL_VIRTUAL_PORT=8001
# Initial delays for the two simulated FIFO member links (milliseconds).
# They can be changed at runtime from the UI or PATCH /api/links/{A|B}.
DRILL_A_DELIVERY_MS=300
DRILL_A_ACK_MS=200
DRILL_B_DELIVERY_MS=150
DRILL_B_ACK_MS=80
# Clock mode:
#   realtime - delays elapse on the wall clock (default)
#   virtual  - the clock only moves when POST /api/clock/advance is called;
#              use it for fast-forward minute-level drills without sleeping.
#              "fastforward" is accepted as an alias for "virtual".
DRILL_CLOCK_MODE=realtime
